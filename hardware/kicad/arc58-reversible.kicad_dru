(version 1)

# JLCPCB distinguishes plated component holes from ordinary vias: tracks must
# remain at least 0.28 mm from a PTH drill edge.  The board-wide 0.20 mm hole
# clearance remains valid for the 0.20 mm through vias and NPTH switch holes.
(rule "JLCPCB PTH hole to track"
    (constraint hole_clearance (min 0.28mm))
    (condition "A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))

# The SK6812MINI-E's reverse-mount land pattern intentionally places its SMD
# pads beside the routed optical aperture.  The Arc footprint preserves 0.10 mm
# of copper; all tracks and vias still use the board-wide 0.25 mm edge rule.
(rule "SK6812MINI-E aperture pads"
    (constraint edge_clearance (min 0.10mm))
    (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && A.memberOfFootprint('SW*') && (A.Pad_Number == '1' || A.Pad_Number == '2' || A.Pad_Number == '3' || A.Pad_Number == '4') && B.Layer == 'Edge.Cuts'"))
